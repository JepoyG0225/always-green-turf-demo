{
  "cleanUrls": true,
  "redirects": [
    { "source": "/schedule", "destination": "/direct-booking", "permanent": false },
    { "source": "/warranty-claim", "destination": "/warranty", "permanent": false },
    {
      "source": "/blog-article.html",
      "has": [{ "type": "query", "key": "article", "value": "pricing-guide-2025" }],
      "destination": "/artificial-grass-cost-arizona",
      "permanent": true
    },
    { "source": "/admin", "destination": "/admin/login", "permanent": false },
    { "source": "/dispatch", "destination": "/admin/login", "permanent": false },
    { "source": "/dispatch/:path*", "destination": "/admin/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/service/area/:slug", "destination": "/:slug" },
    { "source": "/jobber/oauth/callback", "destination": "/api/jobber-callback" },
    { "source": "/quote-pdfs/:file", "destination": "/api/quote-pdf?file=:file" }
  ],
  "functions": {
    "api/jobber-job-closed.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/sheet-leads", "schedule": "*/15 * * * *" }
  ]
}
